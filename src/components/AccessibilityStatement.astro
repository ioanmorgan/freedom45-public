---
// Accessibility statement, following the shape of the
// GOV.UK sample statement. Keep the known issues honest: re-test and update
// the list and the dates whenever the site changes.
import { CONTACT_EMAIL } from '../config';
import CTA from './CTA.astro';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');

const copy = {
  en: {
    h1: 'Accessibility statement',
    intro: 'This statement covers freedom45.co.uk, the website of Freedom45 Labs Ltd. We want as many people as possible to be able to use it. You should be able to:',
    can: [
      'zoom in up to 400% without text spilling off the screen',
      'use every page with a keyboard alone, with the focus always visible',
      'listen to most of the website using a screen reader',
      'turn off the moving background and animations by setting "reduce motion" in your device settings',
    ],
    howTitle: 'How accessible this website is',
    how: 'We are not aware of any part of this website that fails WCAG 2.2 level AA. If you find one, please tell us and we will fix it.',
    issues: [] as string[],
    reportTitle: 'Feedback and reporting problems',
    report: 'If you find a problem we have not listed, or you need something on this website in a different format, email us. We will reply in Welsh or English.',
    techTitle: 'Technical information',
    tech: [
      'Freedom45 Labs is a private company, so the Public Sector Bodies Accessibility Regulations 2018 do not apply to this website. We hold it to the same standard we build to for public sector clients: the Web Content Accessibility Guidelines (WCAG) version 2.2, level AA.',
      'We believe this website is fully compliant with WCAG 2.2 level AA.',
    ],
    prepTitle: 'Preparation of this statement',
    prep: "This statement was prepared on 9 November 2026 and last reviewed on 11 November 2026. The site is checked automatically against WCAG 2.2 AA every time it's published, and tested by hand after any significant change.",
  },
}.en;
---

<main class="page">
  <p class="eyebrow">Accessibility</p>
  <h1>{copy.h1}</h1>

  <p>{copy.intro}</p>
  <ul>
    {copy.can.map((item) => <li>{item}</li>)}
  </ul>

  <h2>{copy.howTitle}</h2>
  <p>{copy.how}</p>
  {copy.issues.length > 0 && (
    <ul>
      {copy.issues.map((item) => <li>{item}</li>)}
    </ul>
  )}

  <h2>{copy.reportTitle}</h2>
  <p>{copy.report}</p>
  <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>

  <h2>{copy.techTitle}</h2>
  {copy.tech.map((item) => <p>{item}</p>)}

  <h2>{copy.prepTitle}</h2>
  <p>{copy.prep}</p>

  <CTA />
</main>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 8rem 1.5rem 3rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1e40af;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: 1rem;
    max-width: 18ch;
  }

  h2 {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin: 2.5rem 0 0.75rem;
  }

  p, li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  p + p { margin-top: 0.75rem; }
  ul { padding-left: 1.25rem; margin-top: 0.5rem; }
  li + li { margin-top: 0.35rem; }

  a { color: #1e40af; }

  /* Same page width and phone spacing as the other pages (ContentLayout) */
  @media (max-width: 768px) {
    .page { padding: 6rem 1.25rem 3rem; }
  }
  @media (max-width: 560px) {
    .page { padding-top: 7.5rem; }
  }
</style>
