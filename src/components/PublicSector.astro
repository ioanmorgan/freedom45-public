---
// The public-sector page, in English or Welsh. Both languages share this one
// template so they can't drift apart. Every claim here traces to the bid library
// (vault Freedom45/bid-library): change the copy there first, then here.
import { CONTACT_EMAIL, COMPANY_NUMBER } from '../config';

interface Props {
  lang: 'en' | 'cy';
}

const { lang } = Astro.props;
const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const PPON = 'PDXX-1452-MBVY';

const copy = {
  en: {
    eyebrow: 'Public sector',
    h1: 'Software for public bodies in Wales and the South West',
    lead: 'Freedom45 Labs is a software studio based in the Swansea Valley, working across Wales and the South West. We design, build, host and support bespoke applications, including websites, mobile apps and desktop apps.',
    switchText: 'Darllenwch y dudalen hon yn Gymraeg',
    switchLang: 'cy',
    switchHref: `${noSlash}/cy/sector-cyhoeddus`,
    workTitle: 'The kind of work we suit',
    work: [
      'Websites and online forms, in Welsh and English where you need them',
      'Apps for staff or the public, on the web, mobile or desktop',
      'Dashboards from data you already hold',
      'Support for digital services you already run',
    ],
    howTitle: 'How we work',
    how: [
      {
        h: 'Welsh and English where you need it',
        p: 'Where a service needs both languages, we build Welsh and English in from the start, not translate at the end.',
      },
      {
        h: 'Accessible as standard',
        p: 'Everything we build meets the accessibility standard public bodies are held to (WCAG 2.2 AA) and, in Wales, the Welsh Language Standards.',
        link: { text: 'Our own accessibility statement', href: `${noSlash}/accessibility` },
      },
      {
        h: 'One accountable lead',
        p: 'The people who scope your project also build it, with trusted contractors when your deadlines need more hands. You deal with one accountable lead throughout.',
      },
    ],
    bgTitle: 'The experience behind us',
    bgIntro: 'Freedom45 Labs was founded in 2026. The experience behind it goes back much further.',
    bg: [
      'Our founder was Head of Engineering at Elucidat, a VC-backed SaaS platform used by large organisations worldwide, having joined as its first full-time developer. Elucidat raised three funding rounds and was acquired in 2025.',
      'Our founder is also co-founder of CogniBuild, an AI workspace for the construction industry that is being trialled by construction companies.',
      'Earlier, as one of two contract developers, our founder built an intranet app used by major UK high-street brands.',
    ],
    buyTitle: 'How to buy from us',
    buy: [
      ['Portals', 'Registered on Sell2Wales and eTenderWales'],
      ['PPON', PPON],
      ['Size', 'SME'],
      ['Company number', COMPANY_NUMBER],
    ],
    contactId: 'contact',
    contactTitle: 'Get in touch',
    contactText: 'Projects of all sizes are welcome, and our low overheads keep our prices down. Email us for a quote, in Welsh or English.',
  },
  cy: {
    eyebrow: 'Sector cyhoeddus',
    h1: 'Meddalwedd i gyrff cyhoeddus yng Nghymru a De-orllewin Lloegr',
    lead: "Stiwdio feddalwedd yng Nghwm Tawe yw Freedom45 Labs, sy'n gweithio ledled Cymru a De-orllewin Lloegr. Rydym yn dylunio, adeiladu, lletya a chefnogi rhaglenni pwrpasol, gan gynnwys gwefannau, apiau symudol ac apiau bwrdd gwaith.",
    switchText: 'Read this page in English',
    switchLang: 'en',
    switchHref: `${noSlash}/public-sector`,
    workTitle: "Y math o waith sy'n addas i ni",
    work: [
      'Gwefannau a ffurflenni ar-lein, yn Gymraeg ac yn Saesneg lle mae angen',
      "Apiau i staff neu i'r cyhoedd, ar y we, ar ffôn symudol neu ar gyfrifiadur",
      'Dangosfyrddau o ddata sydd gennych eisoes',
      "Cefnogaeth i wasanaethau digidol rydych chi'n eu rhedeg yn barod",
    ],
    howTitle: 'Sut rydym yn gweithio',
    how: [
      {
        h: "Cymraeg a Saesneg lle mae eu hangen",
        p: "Lle mae gwasanaeth angen y ddwy iaith, rydym yn adeiladu'r Gymraeg a'r Saesneg i mewn o'r dechrau, yn hytrach na chyfieithu ar y diwedd.",
      },
      {
        h: 'Hygyrch fel safon',
        p: "Mae popeth a adeiladwn yn bodloni'r safon hygyrchedd y mae'n rhaid i gyrff cyhoeddus ei chyrraedd (WCAG 2.2 AA) ac, yng Nghymru, Safonau'r Gymraeg.",
        link: { text: 'Ein datganiad hygyrchedd ni', href: `${noSlash}/cy/hygyrchedd` },
      },
      {
        h: 'Un arweinydd atebol',
        p: "Yr un bobl sy'n cynllunio'ch prosiect sy'n ei adeiladu, gyda chontractwyr dibynadwy pan fo'ch terfynau amser yn galw am fwy o ddwylo. Byddwch yn delio ag un arweinydd atebol drwy gydol y gwaith.",
      },
    ],
    bgTitle: "Y profiad y tu ôl i ni",
    bgIntro: "Sefydlwyd Freedom45 Labs yn 2026, ond mae'r profiad y tu ôl iddo yn mynd yn ôl ymhellach o lawer.",
    bg: [
      "Bu ein sylfaenydd yn Bennaeth Peirianneg yn Elucidat, platfform SaaS a gefnogwyd gan gyfalaf menter ac a ddefnyddir gan sefydliadau mawr ledled y byd, ar ôl ymuno fel ei ddatblygwr llawn amser cyntaf. Cododd Elucidat dair rownd o fuddsoddiad, a chafodd ei brynu yn 2025.",
      "Mae ein sylfaenydd hefyd yn gyd-sylfaenydd CogniBuild, gweithle AI ar gyfer y diwydiant adeiladu sy'n cael ei dreialu gan gwmnïau adeiladu.",
      "Cyn hynny, fel un o ddau ddatblygwr ar gontract, adeiladodd ein sylfaenydd ap mewnrwyd a ddefnyddiwyd gan rai o frandiau mawr y stryd fawr yn y DU.",
    ],
    buyTitle: 'Sut i brynu gennym ni',
    buy: [
      ['Pyrth', 'Wedi cofrestru ar GwerthwchiGymru (Sell2Wales) ac eTenderWales'],
      ['PPON', PPON],
      ['Maint', 'Busnes bach a chanolig (BBaCh)'],
      ['Rhif cwmni', COMPANY_NUMBER],
    ],
    contactId: 'cysylltu',
    contactTitle: 'Cysylltwch â ni',
    contactText: "Mae croeso i brosiectau o bob maint, ac mae ein costau cyffredinol isel yn cadw ein prisiau i lawr. Anfonwch e-bost atom am ddyfynbris, yn Gymraeg neu'n Saesneg.",
  },
}[lang];
---

<main class="page">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.h1}</h1>
  <p class="lead">{copy.lead}</p>
  <p class="switch"><a href={copy.switchHref} lang={copy.switchLang} hreflang={copy.switchLang}>{copy.switchText}</a></p>

  <section class="block" aria-labelledby="work-title">
    <h2 id="work-title">{copy.workTitle}</h2>
    <ul class="work">
      {copy.work.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="block" aria-labelledby="how-title">
    <h2 id="how-title">{copy.howTitle}</h2>
    <div class="cards">
      {copy.how.map((c) => (
        <div class="card">
          <h3>{c.h}</h3>
          <p>{c.p}</p>
          {c.link && <p class="card-link"><a href={c.link.href}>{c.link.text}</a></p>}
        </div>
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="bg-title">
    <h2 id="bg-title">{copy.bgTitle}</h2>
    <p>{copy.bgIntro}</p>
    <ul class="bg">
      {copy.bg.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="block" aria-labelledby="buy-title">
    <h2 id="buy-title">{copy.buyTitle}</h2>
    <dl class="facts">
      {copy.buy.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="block contact" id={copy.contactId} aria-labelledby="contact-title">
    <h2 id="contact-title">{copy.contactTitle}</h2>
    <p>{copy.contactText}</p>
    <p><a class="email" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
  </section>
</main>

<style>
  .page {
    max-width: 720px;
    margin: 0 auto;
    padding: 8rem 1.5rem 3rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1e40af;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .switch {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  a { color: #1e40af; }

  .block { margin-top: 3rem; }

  h2 {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .block > p,
  li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  ul { padding-left: 1.25rem; }
  .bg { margin-top: 0.75rem; }
  .bg li + li { margin-top: 0.5rem; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .card {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
  }

  .card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .card-link { margin-top: 0.5rem; font-weight: 600; }

  .facts {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
  }

  .facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .facts dt { font-weight: 700; }
  .facts dd { color: var(--text-secondary); }

  .email {
    display: inline-block;
    margin-top: 0.25rem;
    font-weight: 600;
    font-size: 1rem;
  }

  @media (max-width: 480px) {
    .facts div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
