---
// The public-sector page. Every claim here traces to the bid library
// (vault Freedom45/bid-library): change the copy there first, then here.
import { COMPANY_NUMBER } from '../config';
import CTA from './CTA.astro';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const PPON = 'PDXX-1452-MBVY';

const copy = {
  en: {
    eyebrow: 'Public sector',
    h1: ['Software for ', 'public bodies', '.'],
    lead: 'Freedom45 Labs is a software studio based in the Swansea Valley, working across Wales, the South West and further afield. We design, build, host and support bespoke applications, including websites, mobile apps and desktop apps. Public bodies get our reduced rates, as part of our ',
    leadLink: { text: 'tech-for-good commitment', href: `${noSlash}/commitments` },
    workTitle: 'The kind of work we suit',
    work: [
      'Websites and digital services, in Welsh and English where you need them',
      'Apps for staff or the public, on the web, mobile or desktop',
      'Dashboards and reporting from data you already hold',
      'Support and improvements for digital services you already run',
      'Technical advice and consultancy: discovery, feasibility, and code or architecture reviews',
    ],
    howTitle: 'What you can count on',
    how: [
      {
        h: 'Welsh and English where you need it',
        p: 'Where a service needs both languages, we build Welsh and English in from the start, to the Welsh Language Standards where they apply.',
      },
      {
        h: 'Accessible as standard',
        p: 'We build to WCAG 2.2 AA, the standard public bodies work to. If an audit raises issues with our work, we\'ll work through them with you, and fix clear failures against WCAG 2.2 AA at no extra cost.',
        link: { text: 'Our own accessibility statement', href: `${noSlash}/accessibility` },
      },
      {
        h: 'One accountable lead',
        p: 'The people who scope your project also build it, with trusted contractors when your deadlines need more hands. You deal with one accountable lead throughout.',
      },
    ],
    bgTitle: "Who you'll be working with",
    bgIntro: 'Freedom45 Labs was founded in 2026, but the people behind it have been building software for years.',
    bgWork: {
      tag: 'Pre-launch review',
      h: 'A procurement platform for UK councils',
      p: 'A startup building procurement software for UK councils asked us to check their platform before launch. We reviewed its security, scalability and code quality, and handed over a prioritised risk list and a roadmap to fix it.',
    },
    bgLink: { text: 'See our work', href: `${noSlash}/our-work` },
    buyTitle: 'How to buy from us',
    buy: [
      ['Portals', 'Registered on Sell2Wales and eTenderWales'],
      ['PPON', PPON],
      ['Size', 'SME'],
      ['Company number', COMPANY_NUMBER],
    ],
  },
}.en;
---

<main class="page">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.h1[0]}<span class="g">{copy.h1[1]}</span>{copy.h1[2]}</h1>
  <p class="lead">{copy.lead}<a href={copy.leadLink.href}>{copy.leadLink.text}</a>.</p>

  <section class="block" aria-labelledby="work-title">
    <h2 id="work-title">{copy.workTitle}</h2>
    <ul class="work">
      {copy.work.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <section class="block" aria-labelledby="how-title">
    <h2 id="how-title">{copy.howTitle}</h2>
    <div class="cards">
      {copy.how.map((c) => (
        <div class="card">
          <h3>{c.h}</h3>
          <p>{c.p}</p>
          {c.link && <p class="card-link"><a href={c.link.href}>{c.link.text}</a></p>}
        </div>
      ))}
    </div>
  </section>

  <section class="block" aria-labelledby="bg-title">
    <h2 id="bg-title">{copy.bgTitle}</h2>
    <p>{copy.bgIntro}</p>
    <div class="card bg-card">
      <p class="tag">{copy.bgWork.tag}</p>
      <h3>{copy.bgWork.h}</h3>
      <p>{copy.bgWork.p}</p>
    </div>
    <p class="card-link"><a href={copy.bgLink.href}>{copy.bgLink.text}</a></p>
  </section>

  <section class="block" aria-labelledby="buy-title">
    <h2 id="buy-title">{copy.buyTitle}</h2>
    <dl class="facts">
      {copy.buy.map(([k, v]) => (
        <div>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </div>
      ))}
    </dl>
  </section>

  <CTA />
</main>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
    padding: 8rem 1.5rem 3rem;
  }

  .eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1e40af;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: 1rem;
    max-width: 18ch;
  }

  /* Same blue-purple highlight as the other page headings */
  h1 .g {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .lead {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .switch {
    margin-top: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  a { color: #1e40af; }

  .block { margin-top: 3rem; }
  .block > p + p { margin-top: 0.75rem; }

  h2 {
    font-size: clamp(1.3rem, 3vw, 1.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .block > p,
  li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  ul { padding-left: 1.25rem; }
  .bg { margin-top: 0.75rem; }
  .bg li + li { margin-top: 0.5rem; }

  .cards {
    display: grid;
    /* Three cards: three across, or one column on a phone - never 2 + 1 */
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .card {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
  }

  .card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
  }

  .card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .card-link { margin-top: 0.5rem; font-weight: 600; }
  .bg-card { margin-top: 1rem; }
  /* Same tag pill as the Our work page */
  .tag {
    display: inline-block; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 0.15rem 0.55rem; border-radius: 100px; margin-bottom: 0.6rem;
    background: #dbeafe; color: #1e40af;
  }

  .facts {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
  }

  .facts div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    font-size: 0.9375rem;
  }

  .facts dt { font-weight: 700; }
  .facts dd { color: var(--text-secondary); }


  @media (max-width: 700px) {
    .cards { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .facts div { grid-template-columns: 1fr; gap: 0; }
  }

  /* Same page width and phone spacing as the other pages (ContentLayout) */
  @media (max-width: 768px) {
    .page { padding: 6rem 1.25rem 3rem; }
  }
  @media (max-width: 560px) {
    .page { padding-top: 7.5rem; }
  }
</style>
