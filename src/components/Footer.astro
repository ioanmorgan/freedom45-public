---
const year = new Date().getFullYear();
const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <p>&copy; {year} Freedom45 Labs Ltd &middot; <a href={`${noSlash}/commitments`}>Our commitments</a> &middot; <a href={`${noSlash}/software-development-south-wales`}>Software development in South Wales</a> &middot; <a href={`${noSlash}/accessibility`}>Accessibility</a></p>
  <p class="legal">Registered in England &amp; Wales &middot; Company no.&nbsp;17127746</p>
</footer>

<style>
  /* Muted, but still 4.5:1 against the background (WCAG 1.4.3) */
  .site-footer {
    text-align: center;
    padding: 2rem 1.5rem;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .site-footer p { margin: 0; }
  .site-footer .legal { max-width: 560px; margin: 0.15rem auto 0; }
  .site-footer a { color: inherit; }
</style>
