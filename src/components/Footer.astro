---
const year = new Date().getFullYear();
const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <nav class="footer-links" aria-label="Footer">
    <a href={`${noSlash}/commitments`}>Our commitments</a>
    <a href={`${noSlash}/accessibility`}>Accessibility</a>
  </nav>
  <p class="legal">&copy; {year} Freedom45 Labs Ltd &middot; Registered in England &amp; Wales &middot; Company no.&nbsp;17127746</p>
</footer>

<style>
  /* Muted, but still 4.5:1 against the background (WCAG 1.4.3) */
  .site-footer {
    text-align: center;
    padding: 2rem 1.5rem;
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .site-footer p { margin: 0; }
  .footer-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.25rem 1.25rem; margin-bottom: 0.5rem; }
  .site-footer .legal { max-width: 560px; margin: 0 auto; }
  .site-footer a { color: inherit; }
</style>
