---
interface Props {
  activePage?: string;
  lang?: 'en' | 'cy';
}

const { activePage = '', lang = 'en' } = Astro.props;
// Base-aware links so the site works at '/' (production) and under a
// sandbox subpath like '/freedom45-social-proof/' without breaking nav.
const base = import.meta.env.BASE_URL;          // '/', or '/demo/'
const noSlash = base.replace(/\/$/, '');        // '',  or '/demo'
---

<header class="site-header">
  <a href={base} class="wordmark">Freedom<span>45</span></a>
  {lang === 'cy' ? (
  <nav class="top-nav" aria-label="Prif">
    <a href={`${noSlash}/cy/sector-cyhoeddus`} class:list={[{ active: activePage === 'public-sector' }]} aria-current={activePage === 'public-sector' ? 'page' : undefined}>Sector cyhoeddus</a>
    <a href={`${noSlash}/cy/sector-cyhoeddus#cysylltu`}>Cysylltu</a>
  </nav>
  ) : (
  <nav class="top-nav" aria-label="Main">
    <a href={`${noSlash}/services`} class:list={[{ active: activePage === 'services' }]} aria-current={activePage === 'services' ? 'page' : undefined}>Services</a>
    <a href={`${noSlash}/how-we-work`} class:list={[{ active: activePage === 'how-we-work' }]} aria-current={activePage === 'how-we-work' ? 'page' : undefined}>How we work</a>
    <a href={`${noSlash}/projects`} class:list={[{ active: activePage === 'projects' }]} aria-current={activePage === 'projects' ? 'page' : undefined}>Projects</a>
    <a href={`${noSlash}/public-sector`} class:list={[{ active: activePage === 'public-sector' }]} aria-current={activePage === 'public-sector' ? 'page' : undefined}>Public sector</a>
    <a href="#contact">Contact</a>
  </nav>
  )}
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Soft fade behind the nav: sits above scrolling content but below the nav
     text, so content dissolves gently under the header instead of colliding. */
  .site-header::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    /* The original soft fade, sized to wherever the links end (--nav-end, set
       below): one row on desktop gives the same ~98px fade as before; when
       the links wrap on a small screen, the fade grows to sit behind them. */
    height: calc(var(--nav-end, 70px) + 28px);
    background: linear-gradient(to bottom,
      var(--bg) 0%,
      rgba(240, 242, 245, 0.95) var(--nav-end, 40px),
      rgba(240, 242, 245, 0) 100%);
    z-index: -1;
    pointer-events: none;
    transform: scaleY(var(--nav-scrim, 0));
    transform-origin: top;
    transition: transform 0.18s ease-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header::before { transition: none; }
  }

  .wordmark {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    text-decoration: none;
  }

  .wordmark span { color: var(--accent); }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .top-nav a {
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 0.02em;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .top-nav a:hover { opacity: 1; }
  .top-nav a.active { opacity: 1; font-weight: 600; }

  @media (max-width: 768px) {
    .site-header { padding: 1rem; }
    .wordmark { font-size: 1rem; }
    .top-nav { gap: 1rem; }
    .top-nav a { font-size: 0.75rem; }
  }

  /* Five links don't fit beside the wordmark on a phone: give them their own row */
  @media (max-width: 560px) {
    .site-header { flex-wrap: wrap; row-gap: 0.5rem; }
    .top-nav { width: 100%; gap: 0.25rem 0.85rem; flex-wrap: wrap; }
    .top-nav a { white-space: nowrap; padding: 0.25rem 0; font-size: 0.75rem; letter-spacing: 0; }
  }

  @media (max-width: 380px) {
    .site-header { padding-left: 0.85rem; padding-right: 0.85rem; }
    .top-nav { column-gap: 0.6rem; }
  }
</style>

<script is:inline>
  // Fade the nav background in gently, in step with scroll position, so it
  // develops with the page instead of snapping in at a threshold. Native-scroll
  // pages drive it.
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;
    // px of scroll over which the scrim grows to full height - longer on mobile,
    // where a quick flick otherwise expands it almost instantly
    var DISTANCE = window.matchMedia('(max-width: 768px)').matches ? 300 : 200;
    // Where the last row of links ends, so the fade always covers them
    function measure() {
      var links = header.querySelectorAll('.top-nav a');
      var end = 0;
      for (var i = 0; i < links.length; i++) {
        end = Math.max(end, links[i].getBoundingClientRect().bottom - header.getBoundingClientRect().top);
      }
      header.style.setProperty('--nav-end', Math.round(end) + 'px');
    }
    measure();
    // The web font can wrap the links onto another row once it loads
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    window.addEventListener('load', measure);
    window.addEventListener('resize', measure, { passive: true });
    var ticking = false;
    function apply() {
      ticking = false;
      var o = Math.min(window.scrollY / DISTANCE, 1);
      header.style.setProperty('--nav-scrim', o.toFixed(3));
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(apply); }
    }, { passive: true });
    apply();
  })();
</script>
