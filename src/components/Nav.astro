---
interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;
// Base-aware links so the site works at '/' (production) and under a
// sandbox subpath like '/freedom45-social-proof/' without breaking nav.
const base = import.meta.env.BASE_URL;          // '/', or '/demo/'
const noSlash = base.replace(/\/$/, '');        // '',  or '/demo'
const isHomepage = Astro.url.pathname === base || Astro.url.pathname === (noSlash || '/');
---

<header class="site-header">
  <a href={base} class="wordmark">Freedom<span>45</span></a>
  <nav class="top-nav">
    <a href={`${noSlash}/services`} class:list={[{ active: activePage === 'services' }]}>Services</a>
    {isHomepage ? (
      <a href="#contact" onclick="window.goToSlide(8);return false">Contact</a>
    ) : (
      <a href={`${noSlash}/#contact`}>Contact</a>
    )}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Soft fade behind the nav: sits above scrolling content but below the nav
     text, so content dissolves gently under the header instead of colliding. */
  .site-header::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 140px;
    background: linear-gradient(to bottom,
      var(--bg) 0%,
      rgba(240, 242, 245, 0.82) 40%,
      rgba(240, 242, 245, 0) 100%);
    z-index: -1;
    pointer-events: none;
  }

  .wordmark {
    font-size: 1.125rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    text-decoration: none;
  }

  .wordmark span { color: var(--accent); }

  .top-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .top-nav a {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    letter-spacing: 0.02em;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .top-nav a:hover { opacity: 1; }
  .top-nav a.active { opacity: 1; font-weight: 600; }

  @media (max-width: 768px) {
    .site-header { padding: 1rem; }
    .wordmark { font-size: 1rem; }
    .top-nav { gap: 1rem; }
    .top-nav a { font-size: 0.75rem; }
  }
</style>
