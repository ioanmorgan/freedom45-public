---
import ContentLayout from '../layouts/ContentLayout.astro';
import { CALENDLY_URL } from '../config';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${noSlash}${p}`;
---

<ContentLayout
  title="Freedom45 | The senior tech team you don't have yet"
  description="Freedom45 Labs is a Swansea Valley software studio. We design, build, host and look after bespoke websites, mobile apps and desktop apps for startups, growing businesses and public bodies."
  wide
>
  <header>
    <h1>The senior tech team you <span class="g">don't have yet.</span></h1>
    <p class="lead">We design, build, host and look after bespoke software: websites, mobile apps and desktop apps. You deal directly with the people building it, from the first prototype to long after launch.</p>
    <p class="actions">
      <a class="btn btn--primary" href={CALENDLY_URL} target="_blank" rel="noopener">Book a call</a>
      <a class="btn" href={u('/projects')}>See our projects</a>
    </p>
  </header>

  <section aria-labelledby="who-title">
    <h2 id="who-title" class="visually-hidden">Who we work with</h2>
    <div class="cards cards--2">
      <a class="card card--link" href={u('/services')}>
        <span class="tag">For startups</span>
        <h3>Prove it, ship it, keep it running</h3>
        <p>A working prototype in weeks, then a product your customers can rely on. No need to hire a CTO first.</p>
        <span class="go" aria-hidden="true">→</span>
      </a>
      <a class="card card--link" href={u('/public-sector')}>
        <span class="tag tag--alt">For public bodies</span>
        <h3>Meets the standards, made to measure</h3>
        <p>We're a Swansea Valley SME working across Wales, the South West and beyond. We build to WCAG 2.2 AA, in Welsh and English where you need it, and you can buy from us through Sell2Wales and eTenderWales.</p>
        <span class="go" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section>
    <h2>What people come to us with</h2>
    <div class="cards">
      <div class="card"><h3>"We've got an idea to test."</h3><p>A working prototype in front of real users within weeks, before the big spend.</p></div>
      <div class="card"><h3>"We need it built properly."</h3><p>Software people can rely on, accessible from day one and hosted for you.</p></div>
      <div class="card"><h3>"It's starting to creak."</h3><p>An honest code review, then the fixes and features it needs next.</p></div>
      <div class="card"><h3>"Nobody's looking after it."</h3><p>Support and upkeep, even for software we didn't build.</p></div>
    </div>
  </section>

  <section class="feature" aria-labelledby="weeks-title">
    <p class="feature-kicker">How we work</p>
    <h2 id="weeks-title">Weeks, not months.</h2>
    <p>Something real in front of your users early, then steady progress you can see. You spend on what works, not on guesses.</p>
    <p class="actions"><a class="btn btn--light" href={u('/how-we-work')}>See how we work</a></p>
  </section>

  <section>
    <div class="section-head">
      <h2>Projects</h2>
      <a href={u('/projects')}>More examples →</a>
    </div>
    <div class="cards">
      <div class="card"><span class="tag">Freedom45</span><h3>A procurement-tech startup</h3><p>An independent code review ahead of the platform's next build phase.</p></div>
      <div class="card"><span class="tag tag--alt">Our founders</span><h3>Elucidat</h3><p>First full-time developer, then Head of Engineering, through three funding rounds to its acquisition in 2025.</p></div>
      <div class="card"><span class="tag tag--alt">Our founders</span><h3>UK high-street retail</h3><p>An intranet app used by staff across several major high-street brands.</p></div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>What we stand by</h2>
      <a href={u('/commitments')}>Our commitments →</a>
    </div>
    <div class="cards">
      <div class="card"><h3>Straight with you</h3><p>Plain English, no lock-in, and AI that a person always checks.</p></div>
      <div class="card"><h3>Built for everyone</h3><p>Everybody should be able to use what we build. WCAG 2.2 AA is where we start.</p></div>
      <div class="card"><h3>Tech for good</h3><p>Reduced rates for public bodies, charities, startups and other social and environmental projects.</p></div>
    </div>
  </section>
</ContentLayout>
