---
import ContentLayout from '../layouts/ContentLayout.astro';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${noSlash}${p}`;
---

<ContentLayout
  title="Freedom45 | The senior tech team you don't have yet"
  description="Freedom45 Labs is a Swansea Valley software studio. We design, build, host and support bespoke websites, mobile apps and desktop apps for startups, growing businesses and public bodies."
  wide
>
  <header>
    <h1>The senior tech team you <span class="g">don't have yet.</span></h1>
    <p class="lead">We design, build, host and support bespoke software, including websites, mobile apps and desktop apps. You work directly with the people building it, from first prototype to long after launch.</p>
  </header>

  <section aria-label="Who we work with">
    <div class="cards cards--2">
      <div class="card">
        <span class="tag">Startups and growing businesses</span>
        <h3>Prove it, ship it, keep it running</h3>
        <p>A working prototype in weeks, then a product your customers can rely on, without hiring a CTO first.</p>
        <p class="more"><a href={u('/services')}>What we do for startups →</a></p>
      </div>
      <div class="card">
        <span class="tag tag--alt">Public bodies</span>
        <h3>Local, accessible, easy to buy</h3>
        <p>A Swansea Valley SME working across Wales, the South West and further afield. Built to WCAG 2.2 AA and, in Wales, the Welsh Language Standards. On Sell2Wales and eTenderWales, and small jobs are welcome.</p>
        <p class="more"><a href={u('/public-sector')}>Public sector work →</a></p>
      </div>
    </div>
  </section>

  <section>
    <h2>What people come to us with</h2>
    <div class="cards">
      <div class="card"><h3>"We have an idea to test."</h3><p>A working prototype in weeks, in front of real users, before the big spend.</p><p class="more"><a href={u('/services/prototypes')}>Prototypes →</a></p></div>
      <div class="card"><h3>"We need it built properly."</h3><p>A product or service people can rely on, accessible from day one, hosted and monitored.</p><p class="more"><a href={u('/services/web-and-mobile-apps')}>Web and mobile apps →</a></p></div>
      <div class="card"><h3>"It's starting to creak."</h3><p>An honest code review, then the performance work and features it needs next.</p><p class="more"><a href={u('/services/support-and-maintenance')}>Support →</a></p></div>
      <div class="card"><h3>"Nobody's looking after it."</h3><p>Support and upkeep after go-live, including systems we didn't build.</p><p class="more"><a href={u('/services/support-and-maintenance')}>Support →</a></p></div>
    </div>
  </section>

  <section>
    <h2>Why people trust us with it</h2>
    <div class="cards">
      <div class="card"><h3>Senior people do the work</h3><p>The people you talk to are the people building it.</p></div>
      <div class="card"><h3>Accessible as standard</h3><p>WCAG 2.2 AA on everything, not an extra.</p></div>
      <div class="card"><h3>Weeks, not months</h3><p>Something real to try early, then steady progress you can see.</p></div>
      <div class="card"><h3>Yours, your choice</h3><p>We host it, or it runs on your own hosting. Either way the code and data are yours, and you're never locked in.</p></div>
      <div class="card"><h3>Projects of all sizes</h3><p>Our low overheads keep our prices down.</p></div>
    </div>
  </section>

  <section>
    <div class="band">
      <p class="eyebrow">Tech for good</p>
      <h2>Software that makes a difference to people's lives.</h2>
      <p>We like work that helps people: public services, charities and community groups, and products everybody can use. Charities and other tech-for-good projects get a discount on our usual rates.</p>
      <p style="margin-top:0.6rem"><span class="todo">[One real example from Ioan's list: who it helped, and how]</span></p>
    </div>
  </section>

  <section>
    <h2>What we stand by</h2>
    <div class="cards cards--2">
      <div class="card"><span class="tag">Our clients</span><h3>Straight with you</h3><p>No jargon, no lock-in, and AI used responsibly, with a person checking everything.</p></div>
      <div class="card"><span class="tag">The people who use it</span><h3>Built for everyone</h3><p>We care that everybody can use what we build. WCAG 2.2 AA is our minimum.</p></div>
      <div class="card"><span class="tag tag--alt">The people we work with</span><h3>Fair work</h3><p>Contractors and suppliers treated and paid fairly, and local talent wherever we can.</p></div>
      <div class="card"><span class="tag tag--alt">Community and planet</span><h3>Doing some good</h3><p>Discounts for tech-for-good projects and early-stage founders, and a small carbon footprint.</p></div>
    </div>
    <p style="margin-top:1rem"><a href={u('/commitments')}><b>Our commitments in full →</b></a></p>
  </section>

  <section>
    <h2>Work we've done</h2>
    <div class="cards cards--2">
      <div>
        <p class="colhead">Freedom45</p>
        <div class="stack">
          <div class="card"><span class="tag">Code review</span><h3>A procurement-tech startup</h3><p>An independent review of the platform's code ahead of its next build phase.</p></div>
          <div class="card"><span class="tag">Client</span><h3>A construction-tech startup our founder co-founded</h3><p>CogniBuild, an AI workspace for construction teams, being trialled by construction companies. <span class="todo">[What Freedom45 did for it]</span></p></div>
        </div>
      </div>
      <div>
        <p class="colhead">Before Freedom45, our founders...</p>
        <div class="stack">
          <div class="card"><span class="tag tag--alt">Scale-up</span><h3>Elucidat</h3><p>First full-time developer, then Head of Engineering, at a VC-backed SaaS platform. Three funding rounds, acquired in 2025.</p></div>
          <div class="card"><span class="tag tag--alt">Retail</span><h3>An intranet app for UK high-street brands</h3><p>Built as one of two contract developers, used by staff across several major high-street brands.</p></div>
        </div>
      </div>
    </div>
    <p style="margin-top:1rem"><a href={u('/work')}><b>More about our work →</b></a></p>
  </section>

  <section>
    <div class="band" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
      <p style="font-weight:600;color:var(--text-primary)">A working prototype in weeks, not months. Here's how we get there.</p>
      <a href={u('/how-we-work')}><b>How we work →</b></a>
    </div>
  </section>
</ContentLayout>
