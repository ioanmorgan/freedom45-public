---
import ContentLayout from '../layouts/ContentLayout.astro';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${noSlash}${p}`;
---

<ContentLayout
  title="Projects | Freedom45"
  description="Work by Freedom45 Labs, and the experience our founders bring from before it: code reviews, a VC-backed SaaS platform and an intranet app for UK high-street brands."
  activePage="projects"
>
  <header>
    <p class="eyebrow">Projects</p>
    <h1>New company. <span class="g">Proven team.</span></h1>
    <p class="lead">Freedom45 Labs started in 2026, but the people behind it have been building software for years. Here's some of that work.</p>
  </header>

  <section>
    <h2>Freedom45</h2>
    <div class="stack">
      <div class="card">
        <span class="tag">Code review</span>
        <h3>A procurement-tech startup</h3>
        <p>An independent review of the platform's code ahead of its next build phase, with each finding checked and sized so the team knew what to tackle first. <span class="todo">[Confirm wording, and the result if there's a true one]</span></p>
      </div>
      <div class="card">
        <span class="tag">Client</span>
        <h3>A construction-tech startup our founder co-founded</h3>
        <p>CogniBuild, an AI workspace for the construction industry, now being trialled by construction companies. <span class="todo">[What Freedom45 did for it]</span></p>
      </div>
      <div class="card">
        <span class="tag">From the list</span>
        <h3><span class="todo">[Sector] client</span></h3>
        <p><span class="todo">[What we built, and the result if there's a true one]</span></p>
      </div>
    </div>
  </section>

  <section>
    <h2>Before Freedom45, our founders...</h2>
    <div class="stack">
      <div class="card">
        <span class="tag tag--alt">Scale-up</span>
        <h3>Elucidat</h3>
        <p>Joined as its first full-time developer and became Head of Engineering, at a VC-backed SaaS platform used by large organisations worldwide. Elucidat raised three funding rounds and was acquired in 2025.</p>
      </div>
      <div class="card">
        <span class="tag tag--alt">Retail</span>
        <h3>An intranet app for UK high-street brands</h3>
        <p>Built as one of two contract developers, and used by staff across several major high-street brands.</p>
      </div>
      <div class="card">
        <span class="tag tag--alt">Sole-trader work</span>
        <h3><span class="todo">[Sector] client</span></h3>
        <p><span class="todo">[What was built, and when]</span></p>
      </div>
    </div>
  </section>

</ContentLayout>
