---
import ContentLayout from '../../layouts/ContentLayout.astro';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${noSlash}${p}`;
---

<ContentLayout
  title="Bilingual Welsh and English Websites and Apps | Freedom45"
  description="Bilingual Welsh and English websites, apps and online services, built to the Welsh Language Standards and WCAG 2.2 AA by a Swansea Valley software studio."
  activePage="services"
>
  <header>
    <p class="eyebrow">Bilingual software</p>
    <h1>Welsh and English, <span class="g">built in.</span></h1>
    <p class="lead">Where a service needs both languages, we build Welsh and English in from the start, not translate at the end. It usually costs less, it reads better, and it meets the Welsh Language Standards where they apply.</p>
    <p style="margin-top:1rem"><a href={u('/cy/sector-cyhoeddus')} lang="cy">Darllenwch am ein gwaith yn Gymraeg</a></p>
  </header>

  <section>
    <h2>Why "built in" matters</h2>
    <p>Translating a finished product usually means layouts that break when Welsh text runs longer, menus left in English, and two versions drifting apart. Building both languages in from the start avoids all three.</p>
  </section>

  <section>
    <h2>What that looks like</h2>
    <ul>
      <li>Users choose their language, and the choice is remembered everywhere.</li>
      <li>Every screen, message, email and error appears in both languages.</li>
      <li>Welsh is never second-best: same quality, same features, same speed.</li>
      <li>Accessible in both languages, to WCAG 2.2 AA, with the language marked up correctly for screen readers.</li>
      <li>Where you need it, your team can update the content in both languages without a developer.</li>
    </ul>
  </section>

  <section>
    <h2>Who it's for</h2>
    <p>Welsh public bodies working to the Welsh Language Standards, and any organisation in Wales that wants to serve its users in the language they prefer.</p>
  </section>

  <section>
    <h2>Where to next</h2>
    <p class="related">
      <a href={u('/public-sector')}>Public sector work</a>
      <a href={u('/services/web-and-mobile-apps')}>Web and mobile apps</a>
      <a href={u('/software-development-swansea')}>Software development in Swansea</a>
    </p>
  </section>
</ContentLayout>
