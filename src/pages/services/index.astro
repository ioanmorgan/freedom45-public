---
import ContentLayout from '../../layouts/ContentLayout.astro';

const noSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const u = (p: string) => `${noSlash}${p}`;
---

<ContentLayout
  title="Services: Prototypes, Apps, Support and Technical Leadership | Freedom45"
  description="Freedom45 services: prototypes and MVPs in weeks, bespoke web, mobile and desktop apps, support and maintenance (including software we didn't build), bilingual Welsh and English services, and fractional CTO leadership."
  activePage="services"
>
  <header>
    <p class="eyebrow">Services</p>
    <h1>From first idea to <span class="g">long-term care.</span></h1>
    <p class="lead">We design, build, host and support bespoke software for startups, growing businesses and public bodies. Start wherever you are.</p>
  </header>

  <section>
    <div class="cards cards--2">
      <div class="card">
        <h3>Prototypes and MVPs</h3>
        <p>A working prototype in weeks, in front of real users, so you know what's worth building before you spend on it.</p>
        <p class="more"><a href={u('/services/prototypes')}>Prototypes and MVPs →</a></p>
      </div>
      <div class="card">
        <h3>Web, mobile and desktop apps</h3>
        <p>Bespoke products and services people can rely on, accessible from day one, hosted by us or on your own hosting.</p>
        <p class="more"><a href={u('/services/web-and-mobile-apps')}>Web and mobile apps →</a></p>
      </div>
      <div class="card">
        <h3>Support and maintenance</h3>
        <p>Fixes, updates, monitoring and the next features, including for software we didn't build.</p>
        <p class="more"><a href={u('/services/support-and-maintenance')}>Support and maintenance →</a></p>
      </div>
      <div class="card">
        <h3>Bilingual Welsh and English services</h3>
        <p>Both languages built in from the start, to the Welsh Language Standards where they apply.</p>
        <p class="more"><a href={u('/services/bilingual-software')}>Bilingual software →</a></p>
      </div>
    </div>
  </section>

  <section>
    <h2>Technical leadership, without a full-time CTO</h2>
    <p>Not ready to hire a CTO? We can act as your technical lead: setting the technical direction, making the architecture calls, reviewing code and helping you hire when it's time.</p>
    <ul style="margin-top:0.75rem">
      <li>Fractional CTO or head of engineering</li>
      <li>Technical strategy and roadmap</li>
      <li>Architecture and code reviews, and managing technical debt</li>
      <li>Mentoring developers and help with hiring</li>
    </ul>
  </section>

  <section>
    <h2>Where to next</h2>
    <p class="related">
      <a href={u('/how-we-work')}>How we work</a>
      <a href={u('/projects')}>Projects</a>
      <a href={u('/public-sector')}>Public sector</a>
      <a href={u('/software-development-south-wales')}>Software development in South Wales</a>
    </p>
  </section>
</ContentLayout>
