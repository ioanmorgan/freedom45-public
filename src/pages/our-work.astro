---
import ContentLayout from '../layouts/ContentLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import { WORK } from '../data/work';

const ours = WORK.filter((w) => w.by === 'freedom45');
const founders = WORK.filter((w) => w.by === 'founders');
---

<ContentLayout
  title="Our work | Freedom45"
  description="Work by Freedom45 Labs, and what the people behind it have built before: a pre-launch review for a council procurement platform, a proof of concept that became a construction-tech startup, and a SaaS scale-up through three funding rounds to acquisition."
  activePage="our-work"
>
  <header>
    <p class="eyebrow">Our work</p>
    <h1>New company. <span class="g">Proven team.</span></h1>
    <p class="lead">Freedom45 Labs started in 2026, but the people behind it have been building software for years. Here's some of that work.</p>
  </header>

  <section>
    <h2>Freedom45</h2>
    <div class="stack">
      {ours.map((item) => <WorkCard item={item} />)}
    </div>
  </section>

  <section>
    <p class="colhead">Our founders' earlier work</p>
    <h2>Years of building what didn't exist yet.</h2>
    <div class="stack">
      {founders.map((item) => <WorkCard item={item} />)}
    </div>
    <p style="margin-top:1rem">And more: APIs and integrations, price-comparison sites, and third-line technical support.</p>
  </section>

</ContentLayout>
