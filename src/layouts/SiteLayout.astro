---
import BaseLayout from './BaseLayout.astro';
import Background from '../components/Background.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { CALENDLY_URL, COMPANY_NUMBER, CONTACT_EMAIL, SITE_NAME, pageUrl } from '../config';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  noFooter?: boolean;
}

const { title, description, activePage, noFooter = false } = Astro.props;

const site = Astro.site!.href.replace(/\/$/, '');
const url = pageUrl(Astro.url.pathname, Astro.site!);
const ogImage = `${site}/og-image.png`;

// Tells search engines (and AI answers) that "Freedom45" is this company.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: SITE_NAME,
      legalName: 'Freedom45 Labs Ltd',
      alternateName: ['Freedom45 Labs', 'Freedom 45'],
      url: `${site}/`,
      logo: `${site}/logo.png`,
      email: CONTACT_EMAIL,
      description: 'Software development studio for startups: technical leadership, software delivery and product development.',
      foundingLocation: { '@type': 'Country', name: 'United Kingdom' },
      areaServed: 'GB',
      identifier: { '@type': 'PropertyValue', propertyID: 'Companies House', value: COMPANY_NUMBER },
      sameAs: [`https://find-and-update.company-information.service.gov.uk/company/${COMPANY_NUMBER}`],
      contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: CONTACT_EMAIL, url: CALENDLY_URL },
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: SITE_NAME,
      url: `${site}/`,
      publisher: { '@id': `${site}/#organization` },
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Freedom45 - software development studio for startups" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Background />
  <Nav activePage={activePage} />
  <div class="page-content">
    <slot />
    {!noFooter && <Footer />}
  </div>
</BaseLayout>

<style>
  .page-content {
    position: relative;
    z-index: 1;
  }
</style>
