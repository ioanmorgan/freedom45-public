---
// Shared layout for the scrolling content pages (home, how we work, our work,
// commitments, services and the South Wales page). One set of styles, so every
// page reads the same and new pages are just markup.
import SiteLayout from './SiteLayout.astro';
import CTA from '../components/CTA.astro';

interface Props {
  title: string;
  description: string;
  activePage?: string;
  wide?: boolean;
  noCta?: boolean;
  noindex?: boolean;
}

const { title, description, activePage, wide = false, noCta = false, noindex = false } = Astro.props;
---

<SiteLayout title={title} description={description} activePage={activePage} noindex={noindex}>
  <main class:list={['cp', { 'cp--wide': wide }]}>
    <slot />
    {!noCta && <CTA />}
  </main>
</SiteLayout>

<style is:global>
  .cp { max-width: 760px; margin: 0 auto; padding: 8rem 1.5rem 3rem; }
  .cp--wide { max-width: 960px; }
  /* Linked-to sections land clear of the fixed nav */
  .cp [id] { scroll-margin-top: 7rem; }
  .cp a { color: #1e40af; }
  .cp .eyebrow {
    font-size: 0.8125rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.05em; color: #1e40af; margin-bottom: 0.5rem;
  }
  .cp h1 {
    font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.035em;
    line-height: 1.1; margin-bottom: 1rem; max-width: 18ch;
  }
  .cp h1 .g {
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .cp .lead { font-size: 1.0625rem; color: var(--text-secondary); line-height: 1.7; max-width: 60ch; }
  .cp section { margin-top: 3.5rem; }
  .cp h2 { font-size: clamp(1.3rem, 3vw, 1.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.2; margin-bottom: 1rem; }
  .cp h3 { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; margin-bottom: 0.35rem; }
  .cp section > p, .cp li { font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.7; }
  .cp section > p + p { margin-top: 0.75rem; }
  .cp ul { padding-left: 1.2rem; }
  .cp li + li { margin-top: 0.35rem; }
  .cp .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .cp .cards--2 { grid-template-columns: repeat(2, 1fr); }
  /* Four cards go 2 x 2 (or 4 across on the wide homepage), never 3 + 1 */
  .cp .cards:has(> :nth-child(4):last-child) { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 900px) {
    .cp--wide .cards:has(> :nth-child(4):last-child) { grid-template-columns: repeat(4, 1fr); }
  }
  .cp .card {
    padding: 1.4rem; background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(0, 0, 0, 0.08); border-radius: 14px;
  }
  .cp .card p { font-size: 0.9375rem; color: var(--text-secondary); line-height: 1.65; }
  .cp .card ul { margin-top: 0.4rem; }
  .cp .card .more { margin-top: 0.6rem; font-weight: 700; }
  .cp .tag {
    display: inline-block; font-size: 0.6875rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; padding: 0.15rem 0.55rem; border-radius: 100px; margin-bottom: 0.6rem;
    background: #dbeafe; color: #1e40af;
  }
  .cp .tag--alt { background: #ede9fe; color: #5b21b6; }
  /* Gaps only Ioan can fill. Kept visible on the preview so nothing ships with one in. */
  .cp .todo { color: #92400e; background: #fef3c7; border-radius: 4px; padding: 0 0.25rem; }
  .cp .band {
    padding: 1.5rem; border-radius: 16px; border: 1px solid rgba(37, 99, 235, 0.2);
    background: linear-gradient(135deg, rgba(37, 99, 235, 0.07), rgba(124, 58, 237, 0.08));
  }
  .cp .band p { color: var(--text-secondary); }
  .cp .colhead {
    font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--text-secondary); margin-bottom: 0.75rem;
  }
  .cp .stack > * + * { margin-top: 0.75rem; }
  .cp .steps { display: grid; gap: 1.5rem; counter-reset: step; }
  .cp .step { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; align-items: start; }
  .cp .step-n {
    counter-increment: step; width: 3rem; height: 3rem; border-radius: 50%;
    display: grid; place-items: center; font-weight: 800; color: #fff;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
  }
  .cp .step-n::before { content: counter(step); }
  .cp .step h3 { font-size: 1.125rem; }
  /* How we work's stage titles are H2s (no H1-to-H3 jump) but look like the step H3s */
  .cp .step h2 { font-size: 1.125rem; font-weight: 700; letter-spacing: -0.01em; line-height: inherit; margin-bottom: 0.35rem; }
  /* The four stages keep the colours they had on the old Services page */
  .cp .stage--explore { color: #7c3aed; }
  .cp .stage--build { color: #2563eb; }
  .cp .stage--grow { color: #0f766e; }
  .cp .stage--sustain { color: #166534; }
  .cp .step-n--explore { background: #7c3aed; }
  .cp .step-n--build { background: #2563eb; }
  .cp .step-n--grow { background: #0f766e; }
  .cp .step-n--sustain { background: #166534; }
  .cp .step p { color: var(--text-secondary); font-size: 0.9375rem; }
  .cp .step ul { margin-top: 0.4rem; }
  .cp .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem; }
  .cp .btn {
    display: inline-block; font-weight: 600; font-size: 0.9375rem; padding: 0.65rem 1.3rem;
    border-radius: 100px; text-decoration: none; color: var(--text-primary);
    background: rgba(255, 255, 255, 0.6); border: 1px solid rgba(0, 0, 0, 0.12);
  }
  .cp .btn--primary { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
  /* "Where to next": chips rather than a row of small text links */
  .cp .related { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .cp .related a {
    display: inline-block; padding: 0.55rem 1.1rem; border-radius: 100px; font-weight: 600;
    font-size: 0.9375rem; text-decoration: none; color: var(--text-primary);
    background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(0, 0, 0, 0.1);
    transition: border-color 0.15s, background 0.15s;
  }
  .cp .related a:hover { border-color: #1d4ed8; background: #fff; }

  /* A whole card as one link: bigger target, no separate link line */
  .cp a.card--link {
    display: block; position: relative; text-decoration: none; color: inherit;
    padding-right: 3rem; transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .cp a.card--link:hover { transform: translateY(-2px); border-color: rgba(29, 78, 216, 0.4); box-shadow: 0 8px 24px rgba(26, 26, 46, 0.08); }
  .cp a.card--link .go {
    position: absolute; right: 1.2rem; bottom: 1.1rem; font-size: 1.25rem; font-weight: 700; color: #1d4ed8;
    transition: transform 0.15s;
  }
  .cp a.card--link:hover .go { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .cp a.card--link, .cp a.card--link .go { transition: none; }
    .cp a.card--link:hover, .cp a.card--link:hover .go { transform: none; }
  }

  /* Section heading with its "see more" link on the same line */
  .cp .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .cp .section-head h2 { margin-bottom: 0; }
  .cp .section-head a { font-weight: 700; font-size: 0.9375rem; white-space: nowrap; }

  /* The one big message on the page */
  .cp .feature {
    padding: clamp(2rem, 5vw, 3rem); border-radius: 20px; color: #fff;
    background: linear-gradient(135deg, #1d4ed8, #6d28d9);
  }
  .cp .feature h2 { color: #fff; font-size: clamp(2rem, 5vw, 3rem); margin-bottom: 0.75rem; }
  .cp .feature > p { color: rgba(255, 255, 255, 0.92); font-size: 1.0625rem; max-width: 52ch; }
  .cp .feature .feature-kicker {
    font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    color: #fff; margin-bottom: 0.5rem;
  }
  .cp .feature .actions { margin-top: 1.25rem; }
  .cp .btn--light { background: #fff; border-color: #fff; color: #1e1b4b; }
  @media (max-width: 700px) {
    .cp .cards--2,
    .cp .cards:has(> :nth-child(4):last-child) { grid-template-columns: 1fr; }
  }
  @media (max-width: 768px) {
    .cp { padding: 6rem 1.25rem 3rem; }
  }
  @media (max-width: 560px) {
    .cp { padding-top: 7.5rem; }
  }
</style>
